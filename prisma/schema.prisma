generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STAFF
  MAGANG
  PM
  ADMIN
}

enum AttendanceStatus {
  HADIR
  SAKIT
  IZIN
  ALPHA
}

enum OvertimeStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  password_hash String
  full_name     String
  role          Role
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())

  // Relations
  attendances           Attendance[]  @relation("UserAttendances")
  overriddenAttendances Attendance[]  @relation("AdminOverrideAttendances")
  overtimes             Overtime[]    @relation("UserOvertimes")
  approvedOvertimes     Overtime[]    @relation("PMApprovedOvertimes")
  activityLogs          ActivityLog[] @relation("UserActivityLogs")

  @@map("users")
}

model Attendance {
  id               String           @id @default(uuid()) @db.Uuid
  user_id          String           @db.Uuid
  record_date      DateTime         @db.Date
  clock_in         DateTime         @db.Timestamp(6)
  clock_out        DateTime?        @db.Timestamp(6)
  duration_minutes Int?
  status           AttendanceStatus @default(HADIR)
  auto_checkout    Boolean          @default(false)
  notes            String?          @db.Text
  override_by      String?          @db.Uuid

  user     User  @relation("UserAttendances", fields: [user_id], references: [id])
  override User? @relation("AdminOverrideAttendances", fields: [override_by], references: [id])

  @@unique([user_id, record_date])
  @@map("attendances")
}

model Overtime {
  id             String         @id @default(uuid()) @db.Uuid
  user_id        String         @db.Uuid
  request_date   DateTime       @db.Date
  duration_hours Int
  reason         String         @db.Text
  status         OvertimeStatus @default(PENDING)
  approved_by    String?        @db.Uuid
  created_at     DateTime       @default(now())

  user     User  @relation("UserOvertimes", fields: [user_id], references: [id])
  approver User? @relation("PMApprovedOvertimes", fields: [approved_by], references: [id])

  @@map("overtimes")
}

model SystemSetting {
  key   String @id
  value String

  @@map("system_settings")
}

model ActivityLog {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String   @db.Uuid
  log_date    DateTime @db.Date
  title       String
  description String   @db.Text
  status      String   @default("DONE") // DONE, IN_PROGRESS, PENDING
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user User @relation("UserActivityLogs", fields: [user_id], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}
